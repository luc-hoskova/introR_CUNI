ubytovani_nezletilych <- typBydleni %>%
filter(vek < 18) %>%
filter(uzemi_txt == "Česká republika") %>%
filter(!is.na(pohlavi_txt)) %>%
filter(bydleni_txt != "Obyvatelstvo podle způsobu bydlení celkem (kromě bezdomovců)") %>%
group_by(bydleni_txt) %>%
