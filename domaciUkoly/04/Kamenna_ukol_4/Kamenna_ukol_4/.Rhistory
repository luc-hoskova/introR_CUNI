library(dplyr)
# 1) Najděte specifickou funkci v balíčku dplyr, která umožňuje přepisování
#    hodnot na NA.
library(dplyr)
library(readr)
typBydleni <- read_csv("sources/typBydleni.csv")
View(typBydleni)
str(typBydleni)
unique(typBydleni)
unique(typBydleni$bydleni_txt)
unique(typBydleni$uzemi_cis)
unique(typBydleni$uzemi_txt)
unique(typBydleni$vek_cis)
# úprava datasetu
typBydleni <- typBydleni %>%
mutate(vek = parse_number(vek_txt)) # převod věku textu na číslo
# sčítání specifických bezdomovců
bezdomovci_brno <- typBydleni %>%
filter(vek %in% 18:26) %>%
filter(uzemi_txt == "Jihomoravský kraj") %>%
filter(bydleni_txt == "Bezdomovci")
bezdomovci_brno
lenght(bezdomovci_brno)
length(bezdomovci_brno)
unique(typBydleni$pohlavi_txt)
perc_muzi <- (length(bezdomovci_brno)/length(bezdomovci_brno$pohlavi_txt == "muž"))*100
perc_muzi
perc_zeny <- 100 - perc_muzi
perc_zeny
perc_muzi <- (length(bezdomovci_brno$pohlavi_txt == "muž")/length(bezdomovci_brno))*100
perc_muzi
perc_muzi
perc_zeny <- 100 - perc_muzi
perc_zeny
# sčítání specifických bezdomovců
bezdomovci_brno <- typBydleni %>%
filter(vek %in% 18:26) %>%
filter(uzemi_txt == "Jihomoravský kraj") %>%
filter(bydleni_txt == "Bezdomovci") %>%
filter(is.na(pohlavi_txt)) # vyřazuju bezpohlavní aby mi nevyšlo 130% jako když jsem je nevyřadila
length(bezdomovci_brno)
# sčítání specifických bezdomovců
bezdomovci_brno <- typBydleni %>%
filter(vek %in% 18:26) %>%
filter(uzemi_txt == "Jihomoravský kraj") %>%
filter(bydleni_txt == "Bezdomovci") %>%
filter(!is.na(pohlavi_txt)) # vyřazuju bezpohlavní aby mi nevyšlo 130% jako když jsem je nevyřadila
length(bezdomovci_brno)
View(bezdomovci_brno)
# sčítání specifických bezdomovců
bezdomovci_brno <- typBydleni %>%
filter(vek %in% 18:26) %>%
filter(uzemi_txt == "Jihomoravský kraj") %>%
filter(bydleni_txt == "Bezdomovci") %>%
filter(!is.na(pohlavi_txt)) # vyřazuju bezpohlavní aby mi nevyšlo 130% jako když jsem je nevyřadila
length(bezdomovci_brno)
perc_muzi <- (length(bezdomovci_brno$pohlavi_txt == "muž")/length(bezdomovci_brno))*100
perc_muzi
perc_zeny <- 100 - perc_muzi
perc_zeny
unique(typBydleni$uzemi_txt)
# 4) Který kraj má nejmenší počet obyvatel žijících v ubytovacích zařízeních?
obyv_ubyt <- typBydleni %>%
filter(uzemi_txt != "Česká republika") %>%  #nechá jenom kraje, ne celou čr
filter(bydleni_txt == "Osoby žijící v ubytovacím zařízení") %>%
select(uzemi_txt, bydleni_txt) %>%
group_by(uzemi_txt) %>%
summarise(min(bydleni_txt))
obyv_ubyt
count(typBydleni, uzemi_cis, uzemi_txt)
# nebo bez počtů řádků:
distinct(typBydleni, uzemi_cis, uzemi_txt)
typBydleni %>%
filter(uzemi_cis == 100,
bydleni_txt == "Osoby žijící v ubytovacím zařízení") %>%
count(pohlavi_txt)          # muž, žena i NA mají stejný počet řádků
typBydleni %>%
filter(uzemi_txt == "Liberecký kraj", vek_txt == "30 let",
bydleni_txt == "Osoby žijící v ubytovacím zařízení") %>%
select(pohlavi_txt, hodnota)   # 3 řádky: NA = muž + žena
unique(typBydleni$ukaz_txt)
# je řádek NA součet mužů a žen?
typBydleni %>%
filter(uzemi_txt == "Liberecký kraj", vek_txt == "30 let",
bydleni_txt == "Byt") %>%
select(pohlavi_txt, hodnota)
# je Česká republika součet krajů?
typBydleni %>%
filter(is.na(pohlavi_txt), vek_txt == "30 let", bydleni_txt == "Byt") %>%
group_by(uzemi_cis) %>%
summarise(soucet = sum(hodnota))
> distinct(typBydleni, uzemi_cis, uzemi_txt)
