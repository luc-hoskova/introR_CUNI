#2
#pojmenujte radky a sloupce v nasledujicim data frame
#provedte pojmenovani alespon dvemi ruznymi zpusoby
cisla <- c(15:18)
boolean <- rep(c(TRUE, FALSE), 2)
text <- c("alpha", "beta", "omega", "gamma")
cbind.data.frame(cisla, boolean, text)
dataframe(cisla, boolean, text)
data.frame(cisla, boolean, text)
#4
#opravte nasledujici kod, ktery vytvari data frame
cbind(1:3, rep(TRUE, 3), c("a", "b", "c"))
matice[1,3] #prvni radek treti sloupec
matice <- matrix(10:33, nrow = 4); matice
matice[1,3] #prvni radek treti sloupec
matice[2,5] #druhy radek, paty sloupec
matice[ ,1] #vsechny hodnoty v prvnim sloupci
matice[2, ] #vsechny hodnoty v druhem radku
matice[1:3,5:6] #prvni az treti radek a paty az sesty sloupec
matice <- matrix(10:33, nrow = 4); matice
matice[1,3] #prvni radek treti sloupec
matice[2,5] #druhy radek, paty sloupec
matice[ ,1] #vsechny hodnoty v prvnim sloupci
matice[2, ] #vsechny hodnoty v druhem radku
matice[1:3,5:6] #prvni az treti radek a paty az sesty sloupec
matice
dimnames(matice) <- list(LETTERS[1:4], letters[1:6])
matice
