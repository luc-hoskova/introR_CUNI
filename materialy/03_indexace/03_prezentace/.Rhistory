matrix(1:25, nrow = 8)
c("alpha", "beta", "omega", "gamma"))
cbind.data.frame(c(15:18), c(rep(c(TRUE, FALSE), 2),c("alpha", "beta", "omega", "gamma"))
cbind.data.frame(c(15:18), c(rep(c(TRUE, FALSE), 2),c("alpha", "beta", "omega", "gamma")))
