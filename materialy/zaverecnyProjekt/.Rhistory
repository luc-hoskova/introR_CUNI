str(novorozenci);head(novorozenci);View(novorozenci);unique(novorozenci$pohlavi);novorozenci2 <- novorozenci;novorozenci2$pohlavi[novorozenci2$pohlavi == 1] <- "Chlapec";novorozenci2$pohlavi[novorozenci2$pohlavi == 2] <- "Děvče";novorozenci2$pohlavi[novorozenci2$pohlavi == 3] <- "Nespecifikováno";unique(novorozenci2$pohlavi);unique(novorozenci$vaginalne_spontanne);is.numeric(novorozenci$vaginalne_spontanne);novorozenci2$vaginalne_spontanne[!is.na(novorozenci2$vaginalne_spontanne)] <- "Ano";novorozenci2$vaginalne_spontanne[is.na(novorozenci2$vaginalne_spontanne)] <- "Ne/Neznámo";unique(novorozenci2$vaginalne_spontanne);unique(novorozenci$gestacni_stari);is.numeric(novorozenci$gestacni_stari);novorozenci2$gestacni_stari[novorozenci2$gestacni_stari == 1] <- "<= 31+6 týden těhotenství";novorozenci2$gestacni_stari[novorozenci2$gestacni_stari == 2] <- "32+0–36+6 týden těhotenství";novorozenci2$gestacni_stari[novorozenci2$gestacni_stari == 3] <- "37+0–38+6 týden těhotenství";novorozenci2$gestacni_stari[novorozenci2$gestacni_stari == 4] <- ">= 39+0 týden těhotenství";novorozenci2$porodni_hmotnost[novorozenci2$porodni_hmotnost == 1] <- "Méně než 1500 g";novorozenci2$porodni_hmotnost[novorozenci2$porodni_hmotnost == 2] <- "1500–2499 g";novorozenci2$porodni_hmotnost[novorozenci2$porodni_hmotnost == 3] <- "2500–3499 g";novorozenci2$porodni_hmotnost[novorozenci2$porodni_hmotnost == 4] <- "3500 g a více";novorozenci2$lecba_sal_masaz[!is.na(novorozenci2$lecba_sal_masaz)] <- "Ano";novorozenci2$lecba_sal_masaz[is.na(novorozenci2$lecba_sal_masaz)] <- "Ne/Neznámo";novorozenci2$lecba_sal_intubace[!is.na(novorozenci2$lecba_sal_intubace)] <- "Ano";novorozenci2$lecba_sal_intubace[is.na(novorozenci2$lecba_sal_intubace)] <- "Ne/Neznámo";unique(novorozenci2$lecba_odd_steroidy_BPD);novorozenci2$lecba_odd_steroidy_BPD[!is.na(novorozenci2$lecba_odd_steroidy_BPD)] <- "Ano";novorozenci2$lecba_odd_steroidy_BPD[is.na(novorozenci2$lecba_odd_steroidy_BPD)] <- "Ne/Neznámo";unique(novorozenci2$lecba_odd_steroidy_BPD);novorozenci2 %>% filter(novorozenci2$pohlavi == "Chlapec", novorozenci2$lecba_sal_intubace == "Ano", novorozenci2$lecba_odd_steroidy_BPD == "Ano") %>% pull(porodni_hmotnost) %>% table() %>% which.max() %>% names();novorozenci2$vrozena_vada[!is.na(novorozenci2$vrozena_vada)] <- "Ano";novorozenci2$vrozena_vada[is.na(novorozenci2$vrozena_vada)] <- "Ne/Neznámo";novorozenci2$propusteni_duvod[novorozenci2$propusteni_duvod == 1] <- "Propuštění domů";novorozenci2$propusteni_duvod[novorozenci2$propusteni_duvod == 2] <- "Překlad do léčebného zařízení";novorozenci2$propusteni_duvod[novorozenci2$propusteni_duvod == 3] <- "Překlad do dětského domova";novorozenci2$propusteni_duvod[novorozenci2$propusteni_duvod == 4] <- "Úmrtí";novorozenci2$propusteni_duvod[novorozenci2$propusteni_duvod == 5] <- "Dovršení 3 měsíců věku"
novorozenci2 %>% filter(novorozenci2$pohlavi == "Děvče", novorozenci2$vaginalne_spontanne == "Ano", novorozenci2$gestacni_stari == "<= 31+6 týden těhotenství", novorozenci2$porodni_hmotnost == "Méně než 1500 g", novorozenci2$lecba_sal_masaz == "Ano") %>% nrow()
novorozenci2 %>% filter(novorozenci2$pohlavi == "Chlapec", novorozenci2$lecba_sal_intubace == "Ano", novorozenci2$lecba_odd_steroidy_BPD == "Ano") %>% pull(porodni_hmotnost) %>% table() %>% which.max() %>% names()
novorozenci2 %>% filter(novorozenci2$vrozena_vada == "Ano", !is.na(gestacni_stari)) %>% count(gestacni_stari)
novorozenci2 %>% filter (novorozenci2$vrozena_vada == "Ano", novorozenci2$propusteni_duvod == "Překlad do dětského domova") %>% pull(pohlavi) %>% table() %>% which.max() %>% names()
