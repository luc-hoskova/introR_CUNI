hodnoceni <- function(x) {
dplyr::case_when(
is.na(x) ~ "neklasifikováno",
x < 50 ~ "nedostatečný",
x < 75 ~ "dobrý",
x < 90 ~ "velmi dobrý",
.default = "výborný")
}
apply(pocetBoduA, 1, hodnoceni)
