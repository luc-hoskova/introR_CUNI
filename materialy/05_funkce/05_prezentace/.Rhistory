N <- 1000 #velikost populace
S <- NULL #Susceptible (ohrozeni)
I <- NULL #Infected (nakazeni)
R <- NULL #Recovered (uzdraveni)
#pocatecni hodnoty
S[1] <- 990
I[1] <- 10
R[1] <- 0
beta <- 0.3 #mira prenosu infekce - jak rychle?
gamma <- 0.1 #mira uzdravovani - jak rychle se I stanou R?
dt <- 1 #casova jednotka - jeden den
for (t in 1:100) { #chceme provest simulaci za 100 dnu
nove_nakazy <- beta * S[t] * I[t] / N * dt #rovnice nakazlivosti
nova_uzdraveni <- gamma * I[t] * dt #rovnice uzdravovani
#proc musi byt v cyklu? protoze se kazdy den meni
#vypocet vyvoje
S[t + 1] <- S[t] - nove_nakazy
I[t + 1] <- I[t] + nove_nakazy - nova_uzdraveni
R[t + 1] <- R[t] + nova_uzdraveni
}
ggplot()
sir <- c(S, I, R); sir
sir <- cbind(S, I, R); sir
ggplot(sir)
ggplot(sir) +
geom_line()
