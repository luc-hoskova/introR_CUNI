library(dplyr)
dojizdeniSkola <- read.csv("dojizdeniSkola.csv",
               na.strings = "",
               stringsAsFactors = TRUE)
str(dojizdeniSkola)

#prejmenovani na snadnejsi nazvy sloupcu a vyber relevantnich sloupcu
  #vytvarime si novy objekt abychom ten puvodni meli v zaloze
ds <- dojizdeniSkola %>%
  rename(pohlavi = pohlavi_txt,
         cil = cil_dojizdky_txt,
         cil_typ = cil_dojizdky_typ,
         bydliste = bydliste_txt) %>%
  select(hodnota, pohlavi, cil, cil_typ, bydliste, bydliste_typ)

#zjisteni, jaky presne nazev ma praha
praha <- ds$cil[grepl("PRAHA", toupper(ds$cil))] %>%
  unique(); praha
  #mame vic hodnot; jedna se o ruzne hodnoty, nebo mensi celky ktere jsou zastiteny jednim vetsim? 

ds %>% filter(cil == "Praha") %>%
  pull(cil_typ) %>%
  unique()
  #vidime, ze se nam praha opakuje vicekrat
    #cilem tedy je vyuzit "nejvyssi" uzemni prvek, tedy kraj

#ktera z Prah je kraj
ds %>%
  filter(cil_typ == "kraj",
         cil %in% praha) %>%
  pull(cil) %>%
  unique() #Hlavni mesto Praha

#jak zjistime, kdo skutecne dojizdi do Prahy?
  #jejich bydliste neni taktez v praze
  #nesmime zapomenout na stejny problem jako s prahou
    #hodnoty se mohou opakovat ve sdruzujicih prvcich
      #chceme proto vybrat pouze samostatne obce
        #ano to nam v datasetu zanecha obce ktere jsou soucasti okresu Praha-zapad/vychod ve Stredoceskem kraji
        #ale tento dataset neposkytuje informace, ktere by je umoznili odfiltrovat
        #a je na povazenou, zda bychom je vubec odfiltrovat meli

levels(ds$bydliste_typ) #správní obvod obce s rozšířenou působností

#tvorba finalniho vycisteneho data frame
doPrahy <- ds %>%
  filter(cil == "Hlavní město Praha",
         !bydliste %in% praha,
         bydliste_typ == "správní obvod obce s rozšířenou působností")

###########################################################################

#1. kolik lidi dojizdi na studia do prahy
sum(doPrahy$hodnota) #109128

#2. z kolika obci dojizdi do prahy
length(unique(doPrahy$bydliste)) #205

#3. z jake obce dojizdi do prahy nejvice zen a z jake muzu
doPrahy %>%
  filter(pohlavi == "žena") %>%
  filter(hodnota == max(hodnota)) %>%
  select(bydliste) #Černošice

doPrahy %>%
  filter(pohlavi == "muž") %>%
  filter(hodnota == max(hodnota)) %>%
  select(bydliste) #Černošice

#4. z jakych obci dojizdi do prahy nejmene osob, kolik a z kolika?
doPrahy %>%
  filter(hodnota != 0) %>% #v nejakych obci muze treba dojizdet 0 muzu ale 1 zena
  select(hodnota, bydliste) %>%
  aggregate(hodnota ~ bydliste, data = ., FUN = sum) %>%
  filter(hodnota == min(hodnota))

